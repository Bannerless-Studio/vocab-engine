# chinese: the pack comes from vocab-engine tools/pack_from_hsk.py (no packbuilder), the eta from the engine's
# tools/zh_eta.json (tests/eta_checks.js --calibrate --write, by hand). Edit the PACKDIFF lines to the round's expected diff.
LANG_CODE=zh
ETA_MODE=external
CONTROLS="flagoff pack_flags"
ENRICH_CMD='python3 "$ENGINE_DIR/tools/pack_from_hsk.py" "$SITE" --out "$SITE/pack"'
PACKDIFF_PACK_KEYS="eta"
PACKDIFF_UNIT_FIELDS="ft,hint"
PACKDIFF_FREE_FILES="attribution.json"
